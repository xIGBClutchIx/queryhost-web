---
import { ClientRouter } from "astro:transitions";

import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  readonly bodyClass?: string;
  readonly clientRouter?: boolean;
  readonly description: string;
  readonly title: string;
}

const { bodyClass, clientRouter = false, description, title } = Astro.props;
const pageTitle = title === "QueryHost" ? title : `${title} · QueryHost`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1215" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {clientRouter && <ClientRouter />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script>
      function preventRedundantNavigation(event: MouseEvent): void {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const link = target.closest<HTMLAnchorElement>("a[href]");
        if (
          link === null ||
          link.hasAttribute("download") ||
          (link.target !== "" && link.target !== "_self") ||
          new URL(link.href).href !== window.location.href
        ) {
          return;
        }

        event.preventDefault();
        event.stopPropagation();
      }

      window.addEventListener("click", preventRedundantNavigation, true);
    </script>
  </body>
</html>
