---
import { ClientRouter } from "astro:transitions";
import { BRAND_ICON_URL } from "../lib/site.js";

import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/base.css";

interface Props {
  readonly bodyClass?: string;
  readonly clientRouter?: boolean;
  readonly description: string;
  readonly title: string;
}

const { bodyClass, clientRouter = true, description, title } = Astro.props;
const pageTitle = title === "QueryHost" ? title : `${title} · QueryHost`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1215" />
    <link rel="icon" type="image/svg+xml" href={BRAND_ICON_URL} />
    <title>{pageTitle}</title>
    {clientRouter && <ClientRouter fallback="swap" />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script>
      import "../scripts/navigation.ts";
      import "../scripts/page-enhancements.ts";
    </script>
  </body>
</html>
