---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { apiReferencePage } from "../../../lib/api-reference.js";
import { requestHostname } from "../../../lib/site.js";
import {
  API_REFERENCE_DESCRIPTION,
  ApiReferencePage,
} from "../../../views/docs/ApiReferencePage.tsx";

const page = apiReferencePage(Astro.params.slug ?? "");
if (page === undefined) {
  return Astro.redirect("/404/", 302);
}
---

<BaseLayout
  bodyClass="docs-page"
  title={page.title}
  description={API_REFERENCE_DESCRIPTION}
>
  <ApiReferencePage hostname={requestHostname(Astro.request)} page={page} />
</BaseLayout>
