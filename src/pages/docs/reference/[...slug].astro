---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { apiReferencePage } from "../../../lib/api-reference.js";
import {
  apiReferenceDescription,
  ApiReferencePage,
} from "../../../views/docs/ApiReferencePage.tsx";

const page = apiReferencePage(Astro.params.slug ?? "");
if (page === undefined) {
  return Astro.rewrite("/404/");
}
---

<BaseLayout
  bodyClass="docs-page"
  title={page.title}
  description={apiReferenceDescription(page)}
>
  <ApiReferencePage page={page} />
</BaseLayout>
