---
import CodeBlock from "../../components/CodeBlock.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
import {
  documentationHref,
  GITHUB_REPOSITORY_URL,
  requestHostname,
} from "../../lib/site.js";

const hostname = requestHostname(Astro.request);
const installSource = `cd ../query
npm run verify
npm pack --pack-destination ../consumer
cd ../consumer
npm install ./queryhost-0.0.0.tgz`;
const firstQuery = `import { query } from "queryhost";

const result = await query({
  game: "rust",
  host: "play.example.com",
  port: 28015,
});

if (result.ok) {
  console.log(result.server.name);
  console.log(result.data.tags);
} else {
  console.error(result.error.code);
}`;
---

<DocsLayout
  activeHref="/"
  eyebrow="Introduction"
  title="Getting started"
  description="Verify the package, install its artifact, and make a typed game-server query from Node.js."
>
  <section class="docs-start-panel" aria-labelledby="package-status">
    <div class="docs-start-panel__summary">
      <p class="docs-start-panel__label">Package status</p>
      <h2 id="package-status">Release-ready, not yet published</h2>
      <p>
        QueryHost remains at <code>0.0.0</code> while distribution stays on the verified
        package artifact. Publishing to npm is a separate release decision.
      </p>
      <a class="docs-source-link" href={GITHUB_REPOSITORY_URL}>
        View QueryHost on GitHub
      </a>
    </div>

    <div class="docs-start-panel__requirements" aria-labelledby="requirements">
      <h2 id="requirements">Before you start</h2>
      <dl>
        <div>
          <dt>Node.js</dt>
          <dd>24 or newer</dd>
        </div>
        <div>
          <dt>npm</dt>
          <dd>12</dd>
        </div>
        <div>
          <dt>Runtime</dt>
          <dd>Server-side DNS, UDP, TCP, and HTTP</dd>
        </div>
      </dl>
    </div>
  </section>

  <h2 id="install">Install from source</h2>
  <p>
    Build and verify the library before packing it. The resulting tarball is the
    same artifact consumed by the hosted services.
  </p>
  <CodeBlock code={installSource} label="Terminal" language="shell" />

  <h2 id="first-query">Make a query</h2>
  <p>
    The literal <code>rust</code> game ID connects <code>result.data</code> to the
    <code>RustData</code> type. Always check <code>result.ok</code> before reading
    success or failure fields.
  </p>
  <CodeBlock code={firstQuery} label="query.ts" language="TypeScript" />

  <h2 id="next">Continue with the docs</h2>
  <nav class="docs-next-links" aria-label="Continue with the documentation">
    <a href={documentationHref(hostname, "/querying/")}>
      <strong>Query a server</strong>
      <span>Ports, modes, deadlines, and accepted aliases.</span>
    </a>
    <a href={documentationHref(hostname, "/results/")}>
      <strong>Read a result</strong>
      <span>Normalized, game-specific, raw, and partial result semantics.</span>
    </a>
    <a href={documentationHref(hostname, "/games/")}>
      <strong>Compare supported games</strong>
      <span>Capabilities and conditional fields for every game profile.</span>
    </a>
    <a href={documentationHref(hostname, "/reference/")}>
      <strong>Open the API reference</strong>
      <span>Generated exports, signatures, and type contracts.</span>
    </a>
  </nav>
</DocsLayout>
