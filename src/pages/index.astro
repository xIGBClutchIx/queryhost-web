---
import { Header } from "../components/Header.tsx";
import { QueryPlayground } from "../components/playground/QueryPlayground.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PLAYGROUND_GAMES } from "../lib/playground-games.js";
import { HOME_HEADLINE, HOME_SUMMARY } from "../lib/site.js";
import { legacyResultLocation } from "../server/result-page.js";

const search = Astro.url.search;
const location = legacyResultLocation(search, PLAYGROUND_GAMES);
if (location !== undefined) {
  return Astro.redirect(location, 301);
}
---

<BaseLayout
  bodyClass="home-page"
  title={HOME_HEADLINE}
  description={HOME_SUMMARY}
>
  <Header active="site" />
  <main class="site-main" id="main-content">
    <QueryPlayground client:load games={PLAYGROUND_GAMES} search={search} />
  </main>
</BaseLayout>
