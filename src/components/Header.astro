---
import {
  documentationHref,
  GITHUB_REPOSITORY_URL,
  requestHostname,
  siteHref,
} from "../lib/site.js";

interface Props {
  readonly active: "docs" | "site";
}

const { active } = Astro.props;
const hostname = requestHostname(Astro.request);
---

<header class="topbar">
  <div
    class:list={[
      "topbar__inner",
      {
        "topbar__inner--docs": active === "docs",
        "topbar__inner--site": active === "site",
      },
    ]}
  >
    <a
      class="brand"
      href={siteHref(hostname)}
      aria-label="QueryHost home"
      data-astro-reload={active === "docs"}
    >
      <span class="brand__query">Query</span><span class="brand__host"
        >Host</span
      >
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      <a
        class:list={["primary-nav__link", { "is-active": active === "docs" }]}
        href={documentationHref(hostname)}
      >
        Docs
      </a>
      <a class="primary-nav__link" href={GITHUB_REPOSITORY_URL}> GitHub </a>
    </nav>
  </div>
</header>
