---
import CustomSelect from "./CustomSelect.astro";
import { GAMES } from "../lib/queryhost.js";
import { defaultQueryMode } from "../lib/playground-defaults.js";

const gameOptions = GAMES.map((game) => ({
  capabilities: game.capabilities,
  defaultMode: defaultQueryMode(game.id),
  defaultPort: game.defaultPort,
  defaultQueryPort: game.defaultQueryPort,
  id: game.id,
  name: game.name,
})).toSorted((left, right) => left.name.localeCompare(right.name, "en"));
const gameSelectOptions = gameOptions.map((game) => ({
  label: game.name,
  value: game.id,
}));
const modeOptions = [
  { label: "Full details", value: "full" },
  { label: "Summary only", value: "summary" },
] as const;
const timeoutOptions = [
  { label: "3 seconds", value: "3000" },
  { label: "5 seconds", value: "5000" },
] as const;
---

<section class="playground" aria-labelledby="query-heading">
  <div class="playground__heading">
    <h1 id="query-heading">Query a server</h1>
    <p>Enter a public game server address to get its current status.</p>
  </div>

  <div class="query-form-dock">
    <form
      class="query-form"
      id="query-form"
      data-games={JSON.stringify(gameOptions)}
    >
      <div class="query-form__primary">
        <CustomSelect
          id="query-game"
          name="game"
          label="Game"
          options={gameSelectOptions}
          selectedValue="minecraft-java"
          required
        />

        <label class="field field--host">
          <span>Host or IP</span>
          <input
            id="query-host"
            name="host"
            type="text"
            required
            maxlength="253"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            placeholder="play.example.com"
          />
        </label>

        <label class="field">
          <span>Game port</span>
          <input
            id="query-port"
            name="port"
            type="number"
            min="1"
            max="65535"
            inputmode="numeric"
          />
        </label>

        <button class="query-submit" id="query-submit" type="submit">
          Query
        </button>
      </div>

      <div class="query-form__advanced" id="query-advanced">
        <button
          class="query-form__advanced-trigger"
          id="query-advanced-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="query-advanced-content"
        >
          Advanced options
        </button>
        <div
          class="query-form__advanced-content"
          id="query-advanced-content"
          aria-hidden="true"
          inert
        >
          <div class="query-form__advanced-content-inner">
            <div class="query-form__secondary">
              <label class="field field--compact">
                <span>Query port</span>
                <input
                  id="query-query-port"
                  name="queryPort"
                  type="number"
                  min="1"
                  max="65535"
                  inputmode="numeric"
                  placeholder="Automatic"
                />
                <small id="query-port-help"
                  >Derived from the selected game.</small
                >
              </label>

              <CustomSelect
                id="query-mode"
                name="mode"
                label="Mode"
                options={modeOptions}
                selectedValue={defaultQueryMode("minecraft-java")}
                help="Full mode requests optional sources."
              />

              <CustomSelect
                id="query-timeout"
                name="timeoutMs"
                label="Deadline"
                options={timeoutOptions}
                selectedValue="5000"
                help="One deadline for the entire query."
              />
            </div>
          </div>
        </div>
      </div>

      <p class="query-form__error" id="query-form-error" role="alert" hidden>
      </p>
    </form>
  </div>

  <section
    class="query-output"
    id="query-output"
    aria-live="polite"
    aria-busy="false"
  >
    <div class="query-loading" id="query-loading" hidden>
      <div class="query-loading__line query-loading__line--short"></div>
      <div class="query-loading__grid">
        <span></span><span></span><span></span><span></span>
      </div>
      <p>Contacting the server through the selected game profile…</p>
    </div>

    <div class="query-request-error" id="query-request-error" hidden>
      <p class="eyebrow" id="query-request-error-code">Request failed</p>
      <h2 id="query-request-error-title">The query could not be sent.</h2>
      <p id="query-request-error-message"></p>
    </div>

    <div class="query-result" id="query-result" hidden>
      <header class="query-result__toolbar">
        <div class="query-result__state">
          <span id="query-result-dot" aria-hidden="true"></span>
          <div>
            <p id="query-result-status">Online</p>
            <h2 id="query-result-name">Server result</h2>
          </div>
        </div>

        <div class="query-tabs" role="tablist" aria-label="Query result views">
          <button
            type="button"
            role="tab"
            id="query-tab-overview"
            aria-controls="query-panel-overview"
            aria-selected="true"
            data-result-tab="overview">Overview</button
          >
          <button
            type="button"
            role="tab"
            id="query-tab-data"
            aria-controls="query-panel-data"
            aria-selected="false"
            data-result-tab="data">Game data</button
          >
          <button
            type="button"
            role="tab"
            id="query-tab-sources"
            aria-controls="query-panel-sources"
            aria-selected="false"
            data-result-tab="sources">Sources</button
          >
          <button
            type="button"
            role="tab"
            id="query-tab-json"
            aria-controls="query-panel-json"
            aria-selected="false"
            data-result-tab="json">JSON</button
          >
        </div>

        <div class="query-result__timing">
          <span id="query-result-cache">Live query</span>
          <strong id="query-result-duration">0 ms</strong>
        </div>
      </header>

      <div
        class="query-panel"
        id="query-panel-overview"
        role="tabpanel"
        aria-labelledby="query-tab-overview"
        data-result-panel="overview"
      >
        <div
          class="query-path"
          id="query-path"
          aria-labelledby="query-path-label"
        >
          <span class="query-path__label" id="query-path-label">Query path</span
          >
          <ol id="query-path-list"></ol>
        </div>
        <div class="query-game-summary" id="query-game-summary" hidden></div>
        <dl class="query-overview" id="query-overview"></dl>
        <div class="query-warnings" id="query-warnings" hidden>
          <h3>Warnings</h3>
          <ul id="query-warning-list"></ul>
        </div>
      </div>

      <div
        class="query-panel"
        id="query-panel-data"
        role="tabpanel"
        aria-labelledby="query-tab-data"
        data-result-panel="data"
        hidden
      >
        <div class="query-data-section">
          <h3>Game-specific data</h3>
          <div class="query-data-list" id="query-data"></div>
        </div>
        <div class="query-data-section" id="query-raw-section" hidden>
          <h3>Raw protocol data</h3>
          <div class="query-data-list" id="query-raw-data"></div>
        </div>
      </div>

      <div
        class="query-panel"
        id="query-panel-sources"
        role="tabpanel"
        aria-labelledby="query-tab-sources"
        data-result-panel="sources"
        hidden
      >
        <div class="query-source-list" id="query-sources"></div>
      </div>

      <div
        class="query-panel query-panel--json"
        id="query-panel-json"
        role="tabpanel"
        aria-labelledby="query-tab-json"
        data-result-panel="json"
        hidden
      >
        <div class="query-json-toolbar">
          <span>Hosted response</span>
          <button type="button" id="query-copy-json">Copy JSON</button>
        </div>
        <pre><code id="query-json" /></pre>
      </div>
    </div>
  </section>
</section>

<script>
  import type {
    JsonObject,
    JsonValue,
    PlaygroundGameDefinition,
    PlaygroundProxyErrorResponse,
    PlaygroundQueryInput,
    PlaygroundQueryResponse,
  } from "../lib/playground-contracts.js";
  import { defaultQueryMode } from "../lib/playground-defaults.js";
  import { requestPlaygroundQuery } from "../lib/playground-query.js";
  import { PlaygroundRequestCoordinator } from "../lib/playground-request-coordinator.js";
  import { queryPathItems } from "../lib/query-path.js";
  import { registerQueryHostWebMcp } from "../lib/webmcp.js";

  function requiredElement<T extends Element>(selector: string): T {
    const element = document.querySelector<T>(selector);
    if (element === null) {
      throw new Error(`Missing playground element: ${selector}`);
    }
    return element;
  }

  function requiredDescendant<T extends Element>(
    root: ParentNode,
    selector: string,
  ): T {
    const element = root.querySelector<T>(selector);
    if (element === null) {
      throw new Error(`Missing playground descendant: ${selector}`);
    }
    return element;
  }

  function parseJson<T>(text: string): T {
    return JSON.parse(text) as T;
  }

  function numericValue(input: HTMLInputElement): number | undefined {
    if (input.value.length === 0) {
      return undefined;
    }
    const value = Number(input.value);
    return Number.isSafeInteger(value) ? value : undefined;
  }

  function milliseconds(value: number): string {
    return `${Math.round(value * 10) / 10} ms`;
  }

  function readableKey(value: string): string {
    return value
      .replaceAll(/([a-z0-9])([A-Z])/g, "$1 $2")
      .replaceAll(/[._-]+/g, " ")
      .replace(/^./, (first) => first.toUpperCase());
  }

  function scalarText(value: JsonValue): string | undefined {
    if (value === null) {
      return "null";
    }
    if (typeof value === "boolean") {
      return value ? "Yes" : "No";
    }
    if (typeof value === "number" || typeof value === "string") {
      return String(value);
    }
    return undefined;
  }

  const playground = requiredElement<HTMLElement>(".playground");
  const formDock = requiredElement<HTMLElement>(".query-form-dock");
  const form = requiredElement<HTMLFormElement>("#query-form");
  const gameSelect = requiredElement<HTMLSelectElement>("#query-game");
  const hostInput = requiredElement<HTMLInputElement>("#query-host");
  const portInput = requiredElement<HTMLInputElement>("#query-port");
  const queryPortInput = requiredElement<HTMLInputElement>("#query-query-port");
  const modeSelect = requiredElement<HTMLSelectElement>("#query-mode");
  const timeoutSelect = requiredElement<HTMLSelectElement>("#query-timeout");
  const advancedOptions = requiredElement<HTMLElement>("#query-advanced");
  const advancedTrigger = requiredElement<HTMLButtonElement>(
    "#query-advanced-trigger",
  );
  const advancedContent = requiredElement<HTMLElement>(
    "#query-advanced-content",
  );
  const portHelp = requiredElement<HTMLElement>("#query-port-help");
  const submitButton = requiredElement<HTMLButtonElement>("#query-submit");
  const formError = requiredElement<HTMLElement>("#query-form-error");
  const output = requiredElement<HTMLElement>("#query-output");
  const loadingState = requiredElement<HTMLElement>("#query-loading");
  const requestError = requiredElement<HTMLElement>("#query-request-error");
  const resultElement = requiredElement<HTMLElement>("#query-result");
  const games = parseJson<readonly PlaygroundGameDefinition[]>(
    form.dataset.games ?? "[]",
  );
  const customSelectRoots = Array.from(
    document.querySelectorAll<HTMLElement>("[data-custom-select]"),
  );

  const pageController = new AbortController();
  const requestCoordinator = new PlaygroundRequestCoordinator(
    pageController.signal,
  );
  let previousGameId = gameSelect.value;
  let responseJson = "";

  function syncQueryDockHeight(): void {
    playground.style.setProperty(
      "--query-dock-height",
      `${formDock.getBoundingClientRect().height}px`,
    );
  }

  const queryDockObserver = new ResizeObserver(syncQueryDockHeight);
  queryDockObserver.observe(formDock);
  syncQueryDockHeight();

  window.addEventListener(
    "pagehide",
    () => {
      queryDockObserver.disconnect();
    },
    { once: true },
  );

  function selectedGame(): PlaygroundGameDefinition {
    const game = games.find((candidate) => candidate.id === gameSelect.value);
    if (game === undefined) {
      throw new Error("The selected game is not in the package registry.");
    }
    return game;
  }

  function updateGameFields(previousDefault?: number): void {
    const game = selectedGame();
    if (
      portInput.value.length === 0 ||
      (previousDefault !== undefined &&
        Number(portInput.value) === previousDefault)
    ) {
      portInput.value = String(game.defaultPort);
    }
    queryPortInput.placeholder =
      game.defaultQueryPort === undefined
        ? "Automatic"
        : String(game.defaultQueryPort);
    portHelp.textContent =
      game.defaultQueryPort === undefined
        ? "Uses the game port unless the profile discovers another target."
        : `Defaults to ${game.defaultQueryPort}; custom game ports preserve the offset.`;
  }

  function setAdvancedOptionsOpen(open: boolean): void {
    advancedOptions.classList.toggle("is-open", open);
    advancedTrigger.setAttribute("aria-expanded", String(open));
    advancedContent.setAttribute("aria-hidden", String(!open));
    advancedContent.inert = !open;
  }

  function syncCustomSelect(select: HTMLSelectElement): void {
    const root = select.closest<HTMLElement>("[data-custom-select]");
    if (root === null) {
      throw new Error(`Custom select root is missing for ${select.id}.`);
    }
    const selected = select.selectedOptions.item(0);
    if (selected === null) {
      throw new Error(`Custom select ${select.id} has no selected option.`);
    }
    requiredDescendant<HTMLElement>(
      root,
      "[data-custom-select-value]",
    ).textContent = selected.textContent;
    for (const option of root.querySelectorAll<HTMLButtonElement>(
      "[data-custom-select-option]",
    )) {
      option.setAttribute(
        "aria-selected",
        String(option.dataset.value === select.value),
      );
    }
  }

  function setCustomSelectOpen(root: HTMLElement, open: boolean): void {
    const trigger = requiredDescendant<HTMLButtonElement>(
      root,
      "[data-custom-select-trigger]",
    );
    const menu = requiredDescendant<HTMLElement>(
      root,
      "[data-custom-select-menu]",
    );
    root.classList.toggle("is-open", open);
    trigger.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-hidden", String(!open));
    menu.inert = !open;
  }

  function closeOtherCustomSelects(activeRoot: HTMLElement): void {
    for (const root of customSelectRoots) {
      if (root !== activeRoot) {
        setCustomSelectOpen(root, false);
      }
    }
  }

  function focusCustomSelectOption(
    root: HTMLElement,
    position: "first" | "last" | "selected",
  ): void {
    const options = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-custom-select-option]"),
    );
    const option =
      position === "first"
        ? options.at(0)
        : position === "last"
          ? options.at(-1)
          : options.find(
              (candidate) => candidate.getAttribute("aria-selected") === "true",
            );
    option?.focus();
  }

  function initializeCustomSelects(): void {
    for (const root of customSelectRoots) {
      const select = requiredDescendant<HTMLSelectElement>(
        root,
        "[data-custom-select-native]",
      );
      const trigger = requiredDescendant<HTMLButtonElement>(
        root,
        "[data-custom-select-trigger]",
      );
      const options = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-custom-select-option]"),
      );

      syncCustomSelect(select);
      trigger.addEventListener("click", () => {
        const open = trigger.getAttribute("aria-expanded") !== "true";
        closeOtherCustomSelects(root);
        setCustomSelectOpen(root, open);
      });
      trigger.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") {
          return;
        }
        event.preventDefault();
        closeOtherCustomSelects(root);
        setCustomSelectOpen(root, true);
        focusCustomSelectOption(
          root,
          event.key === "ArrowDown" ? "selected" : "last",
        );
      });

      for (const [index, option] of options.entries()) {
        option.addEventListener("click", () => {
          const value = option.dataset.value;
          if (value === undefined) {
            return;
          }
          select.value = value;
          syncCustomSelect(select);
          select.dispatchEvent(new Event("change", { bubbles: true }));
          setCustomSelectOpen(root, false);
          trigger.focus();
        });
        option.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            event.preventDefault();
            setCustomSelectOpen(root, false);
            trigger.focus();
            return;
          }
          if (event.key === "Home" || event.key === "End") {
            event.preventDefault();
            focusCustomSelectOption(
              root,
              event.key === "Home" ? "first" : "last",
            );
            return;
          }
          if (event.key !== "ArrowDown" && event.key !== "ArrowUp") {
            return;
          }
          event.preventDefault();
          const direction = event.key === "ArrowDown" ? 1 : -1;
          options
            .at((index + direction + options.length) % options.length)
            ?.focus();
        });
      }

      root.addEventListener("focusout", (event) => {
        const nextTarget = event.relatedTarget;
        if (nextTarget instanceof Node && root.contains(nextTarget)) {
          return;
        }
        setCustomSelectOpen(root, false);
      });
    }

    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) {
        return;
      }
      for (const root of customSelectRoots) {
        if (!root.contains(target)) {
          setCustomSelectOpen(root, false);
        }
      }
    });
  }

  function showOnly(state: "error" | "idle" | "loading" | "result"): void {
    loadingState.hidden = state !== "loading";
    requestError.hidden = state !== "error";
    resultElement.hidden = state !== "result";
    output.setAttribute("aria-busy", state === "loading" ? "true" : "false");
  }

  function showFormError(message: string): void {
    formError.textContent = message;
    formError.hidden = false;
  }

  function clearFormError(): void {
    formError.textContent = "";
    formError.hidden = true;
  }

  function proxyError(
    code: string,
    message: string,
    title = "The query could not be sent.",
  ): void {
    requiredElement<HTMLElement>("#query-request-error-code").textContent =
      code;
    requiredElement<HTMLElement>("#query-request-error-title").textContent =
      title;
    requiredElement<HTMLElement>("#query-request-error-message").textContent =
      message;
    showOnly("error");
  }

  function addOverviewRow(
    container: HTMLDListElement,
    label: string,
    value: string,
  ): void {
    const group = document.createElement("div");
    const term = document.createElement("dt");
    const description = document.createElement("dd");
    term.textContent = label;
    description.textContent = value;
    group.append(term, description);
    container.append(group);
  }

  function isJsonObject(value: JsonValue | undefined): value is JsonObject {
    return typeof value === "object" && value !== null && !Array.isArray(value);
  }

  function jsonString(
    object: JsonObject,
    property: string,
  ): string | undefined {
    const value = object[property];
    return typeof value === "string" ? value : undefined;
  }

  function minecraftFavicon(data: JsonObject): string | undefined {
    const favicon = jsonString(data, "favicon");
    if (
      favicon === undefined ||
      favicon.length > 100_000 ||
      !/^data:image\/png;base64,[A-Za-z0-9+/]+={0,2}$/u.test(favicon)
    ) {
      return undefined;
    }
    return favicon;
  }

  function renderMinecraftSummary(
    game: PlaygroundQueryInput["game"],
    data: JsonObject,
  ): void {
    const summary = requiredElement<HTMLElement>("#query-game-summary");
    summary.replaceChildren();
    summary.hidden = true;

    if (game !== "minecraft-java" && game !== "minecraft-bedrock") {
      return;
    }

    const motdValue = data.motd;
    const motdObject = isJsonObject(motdValue) ? motdValue : undefined;
    const motdPlain =
      typeof motdValue === "string"
        ? motdValue
        : motdObject === undefined
          ? undefined
          : jsonString(motdObject, "plain");
    const motdHtml =
      motdObject === undefined ? undefined : jsonString(motdObject, "html");
    const favicon =
      game === "minecraft-java" ? minecraftFavicon(data) : undefined;

    if (
      motdPlain === undefined &&
      motdHtml === undefined &&
      favicon === undefined
    ) {
      return;
    }

    if (favicon !== undefined) {
      const image = document.createElement("img");
      image.alt = "Minecraft server favicon";
      image.decoding = "async";
      image.height = 64;
      image.src = favicon;
      image.width = 64;
      summary.append(image);
    }

    if (motdPlain !== undefined || motdHtml !== undefined) {
      const content = document.createElement("div");
      const label = document.createElement("span");
      const motd = document.createElement("p");
      label.textContent = "Message of the day";
      if (motdHtml !== undefined) {
        // QueryHost emits only escaped text and allow-listed formatting here.
        motd.innerHTML = motdHtml;
      } else {
        motd.textContent = motdPlain ?? "";
      }
      content.append(label, motd);
      summary.append(content);
    }

    summary.hidden = false;
  }

  function renderDataObject(container: HTMLElement, data: JsonObject): void {
    container.replaceChildren();
    const entries = Object.entries(data);
    if (entries.length === 0) {
      const empty = document.createElement("p");
      empty.className = "query-data-empty";
      empty.textContent = "This server did not return game-specific fields.";
      container.append(empty);
      return;
    }

    for (const [key, value] of entries) {
      const row = document.createElement("div");
      const label = document.createElement("span");
      const content = document.createElement("div");
      label.textContent = readableKey(key);
      const scalar = scalarText(value);
      if (scalar === undefined) {
        const pre = document.createElement("pre");
        const code = document.createElement("code");
        code.textContent = JSON.stringify(value, null, 2);
        pre.append(code);
        content.append(pre);
      } else {
        content.textContent = scalar;
      }
      row.append(label, content);
      container.append(row);
    }
  }

  function renderSources(result: PlaygroundQueryResponse): void {
    const container = requiredElement<HTMLElement>("#query-sources");
    container.replaceChildren();
    for (const source of result.sources) {
      const row = document.createElement("div");
      const identity = document.createElement("div");
      const dot = document.createElement("span");
      const name = document.createElement("strong");
      const status = document.createElement("span");
      const timing = document.createElement("code");
      dot.className = `query-source-dot query-source-dot--${source.status}`;
      name.textContent = source.source;
      status.textContent = readableKey(source.status);
      identity.append(dot, name, status);
      timing.textContent =
        source.rttMs === undefined ? "—" : milliseconds(source.rttMs);
      row.append(identity, timing);
      container.append(row);
    }
  }

  function renderQueryPath(result: PlaygroundQueryResponse): void {
    const path = requiredElement<HTMLElement>("#query-path");
    const list = requiredElement<HTMLOListElement>("#query-path-list");
    const items = queryPathItems(result.sources);
    list.replaceChildren();
    path.hidden = items.length === 0;
    list.style.setProperty("--query-path-count", String(items.length));

    for (const item of items) {
      const step = document.createElement("li");
      const node = document.createElement("span");
      const content = document.createElement("div");
      const label = document.createElement("strong");
      const detail = document.createElement("code");
      step.className = `query-path__step query-path__step--${item.status}`;
      step.title = item.source;
      node.className = "query-path__node";
      node.ariaHidden = "true";
      label.textContent = item.label;
      detail.textContent = item.detail;
      content.append(label, detail);
      step.append(node, content);
      list.append(step);
    }
  }

  function renderWarnings(result: PlaygroundQueryResponse): void {
    const warningBox = requiredElement<HTMLElement>("#query-warnings");
    const warningList = requiredElement<HTMLUListElement>(
      "#query-warning-list",
    );
    warningList.replaceChildren();
    warningBox.hidden = result.warnings.length === 0;
    for (const warning of result.warnings) {
      const item = document.createElement("li");
      const code = document.createElement("code");
      const message = document.createElement("span");
      code.textContent = warning.code;
      message.textContent = warning.message;
      item.append(code, message);
      warningList.append(item);
    }
  }

  function renderResult(result: PlaygroundQueryResponse, raw: string): void {
    responseJson = raw;
    const overview = requiredElement<HTMLDListElement>("#query-overview");
    const status = requiredElement<HTMLElement>("#query-result-status");
    const name = requiredElement<HTMLElement>("#query-result-name");
    const dot = requiredElement<HTMLElement>("#query-result-dot");
    const cache = requiredElement<HTMLElement>("#query-result-cache");
    overview.replaceChildren();

    cache.textContent =
      result.cache.status === "hit"
        ? `Cache hit · ${milliseconds(result.cache.ageMs)} old`
        : result.cache.status === "coalesced"
          ? "Shared in-flight query"
          : "Live query";
    requiredElement<HTMLElement>("#query-result-duration").textContent =
      milliseconds(result.durationMs);

    addOverviewRow(overview, "Game", result.game);
    if (result.ok) {
      status.textContent = result.partial ? "Online · partial" : "Online";
      name.textContent = result.server.name ?? "Unnamed server";
      dot.className = result.partial ? "is-partial" : "is-online";
      if (result.server.map !== undefined) {
        addOverviewRow(overview, "Map", result.server.map);
      }
      if (result.server.version !== undefined) {
        addOverviewRow(overview, "Version", result.server.version);
      }
      if (result.server.players !== undefined) {
        const online = result.server.players.online;
        const maximum = result.server.players.max;
        const players =
          online === undefined
            ? `— / ${maximum ?? "—"}`
            : `${online} / ${maximum ?? "—"}`;
        addOverviewRow(overview, "Players", players);
      }
      if (result.server.password !== undefined) {
        addOverviewRow(
          overview,
          "Password",
          result.server.password ? "Required" : "Not required",
        );
      }
      if (result.server.queryRttMs !== undefined) {
        addOverviewRow(
          overview,
          "Query RTT",
          milliseconds(result.server.queryRttMs),
        );
      }
      renderMinecraftSummary(result.game, result.data);
      renderDataObject(requiredElement("#query-data"), result.data);
      const rawSection = requiredElement<HTMLElement>("#query-raw-section");
      rawSection.hidden = result.rawData === undefined;
      if (result.rawData !== undefined) {
        renderDataObject(requiredElement("#query-raw-data"), result.rawData);
      }
    } else {
      requiredElement<HTMLElement>("#query-game-summary").hidden = true;
      status.textContent = "Offline or unreachable";
      name.textContent = result.error.message;
      dot.className = "is-offline";
      addOverviewRow(overview, "Error", result.error.code);
      if (result.error.source !== undefined) {
        addOverviewRow(overview, "Required source", result.error.source);
      }
      renderDataObject(requiredElement("#query-data"), {});
      requiredElement<HTMLElement>("#query-raw-section").hidden = true;
    }

    renderWarnings(result);
    renderQueryPath(result);
    renderSources(result);
    requiredElement<HTMLElement>("#query-json").textContent = JSON.stringify(
      parseJson<JsonValue>(raw),
      null,
      2,
    );
    activateTab("overview");
    showOnly("result");
  }

  function activateTab(name: string): void {
    for (const tab of document.querySelectorAll<HTMLButtonElement>(
      "[data-result-tab]",
    )) {
      const active = tab.dataset.resultTab === name;
      tab.setAttribute("aria-selected", active ? "true" : "false");
      tab.tabIndex = active ? 0 : -1;
    }
    for (const panel of document.querySelectorAll<HTMLElement>(
      "[data-result-panel]",
    )) {
      panel.hidden = panel.dataset.resultPanel !== name;
    }
  }

  function formQueryInput(): PlaygroundQueryInput | undefined {
    if (!form.reportValidity()) {
      return undefined;
    }
    const game = selectedGame();
    const host = hostInput.value.trim();
    if (
      /[\s/?#@]/u.test(host) ||
      host.includes("[") ||
      host.includes("]") ||
      host.includes("%")
    ) {
      showFormError("Enter a plain hostname or IP address without URL syntax.");
      hostInput.focus();
      return undefined;
    }
    const port = numericValue(portInput);
    const queryPort = numericValue(queryPortInput);
    const timeoutMs = Number(timeoutSelect.value);
    return {
      game: game.id,
      host,
      ...(port === undefined ? {} : { port }),
      ...(queryPort === undefined ? {} : { queryPort }),
      mode: modeSelect.value === "summary" ? "summary" : "full",
      timeoutMs,
    };
  }

  function applyQueryInput(input: PlaygroundQueryInput): void {
    const game = games.find((candidate) => candidate.id === input.game);
    if (game === undefined) {
      return;
    }

    gameSelect.value = game.id;
    previousGameId = game.id;
    updateGameFields();
    hostInput.value = typeof input.host === "string" ? input.host : "";
    portInput.value = typeof input.port === "number" ? String(input.port) : "";
    queryPortInput.value =
      typeof input.queryPort === "number" ? String(input.queryPort) : "";
    modeSelect.value =
      input.mode === "full" || input.mode === "summary"
        ? input.mode
        : "summary";
    timeoutSelect.value = input.timeoutMs === 3_000 ? "3000" : "5000";
    syncCustomSelect(gameSelect);
    syncCustomSelect(modeSelect);
    syncCustomSelect(timeoutSelect);
    setAdvancedOptionsOpen(
      input.queryPort !== undefined ||
        input.mode === "full" ||
        input.timeoutMs === 3_000,
    );
  }

  function updateShareUrl(input: PlaygroundQueryInput): void {
    const url = new URL(window.location.href);
    url.search = "";
    url.searchParams.set("game", input.game);
    url.searchParams.set("host", input.host);
    if (input.port !== undefined) {
      url.searchParams.set("port", String(input.port));
    }
    if (input.queryPort !== undefined) {
      url.searchParams.set("queryPort", String(input.queryPort));
    }
    if (input.mode === "summary") {
      url.searchParams.set("mode", "summary");
    }
    if (input.timeoutMs !== undefined && input.timeoutMs !== 5_000) {
      url.searchParams.set("timeoutMs", String(input.timeoutMs));
    }
    history.replaceState(null, "", url);
  }

  async function runQuery(
    input: PlaygroundQueryInput,
    executionSignal?: AbortSignal,
  ): Promise<PlaygroundProxyErrorResponse | PlaygroundQueryResponse> {
    clearFormError();
    const request = requestCoordinator.start(executionSignal);
    updateShareUrl(input);
    submitButton.disabled = true;
    submitButton.textContent = "Querying…";
    showOnly("loading");

    try {
      const response = await requestPlaygroundQuery(input, request.signal);
      if (!request.isCurrent()) {
        throw new DOMException("The query was superseded.", "AbortError");
      }
      if (response.kind === "proxy-error") {
        const failure = response.body;
        proxyError(failure.error.code, failure.error.message);
        return failure;
      }
      renderResult(response.body, response.raw);
      return response.body;
    } catch (error) {
      if (!request.isCurrent()) {
        throw new DOMException("The query was cancelled.", "AbortError");
      }
      if (request.signal.aborted) {
        showOnly("idle");
        throw new DOMException("The query was cancelled.", "AbortError");
      }
      const message =
        error instanceof Error
          ? error.message
          : "The browser could not reach the QueryHost web service.";
      const failure: PlaygroundProxyErrorResponse = {
        error: { code: "NETWORK_ERROR", message },
      };
      proxyError(failure.error.code, failure.error.message);
      return failure;
    } finally {
      if (request.isCurrent()) {
        submitButton.disabled = false;
        submitButton.textContent = "Query";
        output.setAttribute("aria-busy", "false");
      }
    }
  }

  function prefillFromUrl(): void {
    const parameters = new URLSearchParams(window.location.search);
    const game = parameters.get("game");
    if (game !== null && games.some((candidate) => candidate.id === game)) {
      gameSelect.value = game;
    }
    previousGameId = gameSelect.value;
    updateGameFields();
    const host = parameters.get("host");
    if (host !== null) {
      hostInput.value = host;
    }
    for (const [name, input] of [
      ["port", portInput],
      ["queryPort", queryPortInput],
    ] as const) {
      const value = parameters.get(name);
      if (value !== null && /^\d{1,5}$/u.test(value)) {
        input.value = value;
      }
    }
    const mode = parameters.get("mode");
    if (mode === "summary" || mode === "full") {
      modeSelect.value = mode;
    } else {
      modeSelect.value = defaultQueryMode(selectedGame().id);
    }
    const timeout = parameters.get("timeoutMs");
    if (timeout === "3000" || timeout === "5000") {
      timeoutSelect.value = timeout;
    }
    setAdvancedOptionsOpen(
      parameters.has("queryPort") || mode === "summary" || timeout === "3000",
    );
  }

  gameSelect.addEventListener("change", () => {
    const previous = games.find(
      (candidate) => candidate.id === previousGameId,
    )?.defaultPort;
    updateGameFields(previous);
    modeSelect.value = defaultQueryMode(selectedGame().id);
    syncCustomSelect(modeSelect);
    previousGameId = gameSelect.value;
  });
  advancedTrigger.addEventListener("click", () => {
    setAdvancedOptionsOpen(
      advancedTrigger.getAttribute("aria-expanded") !== "true",
    );
  });
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    clearFormError();
    const input = formQueryInput();
    if (input !== undefined) {
      void runQuery(input).catch(() => undefined);
    }
  });
  for (const tab of document.querySelectorAll<HTMLButtonElement>(
    "[data-result-tab]",
  )) {
    tab.addEventListener("click", () =>
      activateTab(tab.dataset.resultTab ?? "overview"),
    );
    tab.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") {
        return;
      }
      const tabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-result-tab]"),
      );
      const currentIndex = tabs.indexOf(tab);
      const direction = event.key === "ArrowRight" ? 1 : -1;
      const next = tabs.at(
        (currentIndex + direction + tabs.length) % tabs.length,
      );
      if (next === undefined) {
        return;
      }
      event.preventDefault();
      activateTab(next.dataset.resultTab ?? "overview");
      next.focus();
    });
  }
  requiredElement<HTMLButtonElement>("#query-copy-json").addEventListener(
    "click",
    (event) => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) {
        return;
      }
      void navigator.clipboard.writeText(responseJson).then(
        () => {
          button.textContent = "Copied";
          window.setTimeout(() => {
            button.textContent = "Copy JSON";
          }, 1_500);
        },
        () => {
          button.textContent = "Copy failed";
        },
      );
    },
  );

  prefillFromUrl();
  initializeCustomSelects();
  const webMcpRegistration = registerQueryHostWebMcp(document, games, {
    queryGameServer: (input, signal) => {
      applyQueryInput(input);
      return runQuery(input, signal);
    },
  });
  void webMcpRegistration?.ready.catch(() => {
    console.warn("QueryHost could not register its WebMCP tools.");
  });
  window.addEventListener(
    "pagehide",
    () => {
      webMcpRegistration?.abort();
      pageController.abort();
    },
    { once: true },
  );
</script>
