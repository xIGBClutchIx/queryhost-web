---
import { DOCUMENTATION_NAVIGATION } from "../lib/navigation.js";
import type { NavigationItem } from "../lib/navigation.js";
import { documentationHref, requestHostname } from "../lib/site.js";

interface Props {
  readonly activeHref: string;
  readonly referenceItems?: readonly NavigationItem[] | undefined;
  readonly referenceLabel?: string | undefined;
}

const { activeHref, referenceItems, referenceLabel } = Astro.props;
const hostname = requestHostname(Astro.request);
---

<nav
  class="docs-nav"
  aria-label="Documentation navigation"
  transition:persist={referenceItems === undefined}
>
  {
    DOCUMENTATION_NAVIGATION.map((section) => (
      <section class="docs-nav__section">
        <h2>{section.label}</h2>
        <ul>
          {section.items.map((item) => (
            <li>
              <a
                class:list={{ "is-active": activeHref === item.href }}
                href={documentationHref(hostname, item.href)}
                aria-current={activeHref === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        {section.label === "Reference" &&
          referenceItems !== undefined &&
          referenceLabel !== undefined && (
            <div class="docs-nav__reference-context">
              <h3>{referenceLabel}</h3>
              <ul>
                {referenceItems.map((item) => (
                  <li>
                    <a
                      class:list={{ "is-active": activeHref === item.href }}
                      href={documentationHref(hostname, item.href)}
                      aria-current={
                        activeHref === item.href ? "page" : undefined
                      }
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
      </section>
    ))
  }
</nav>

<script>
  function synchronizeActiveDocumentationLink(): void {
    const navigation = document.querySelector<HTMLElement>(".docs-nav");
    if (navigation === null) {
      return;
    }

    const currentPath = window.location.pathname;
    for (const link of navigation.querySelectorAll<HTMLAnchorElement>("a")) {
      const active = new URL(link.href).pathname === currentPath;
      link.classList.toggle("is-active", active);
      if (active) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    }
  }

  document.addEventListener(
    "astro:page-load",
    synchronizeActiveDocumentationLink,
  );
  document.addEventListener(
    "astro:after-swap",
    synchronizeActiveDocumentationLink,
  );
</script>
