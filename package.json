{
  "name": "@queryhost/web",
  "description": "QueryHost public site, documentation, and playground boundary.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build:mcp-app": "node scripts/build-mcp-app.mjs",
    "predev": "npm run build:mcp-app",
    "prebuild": "npm run build:mcp-app",
    "pretest": "npm run build:mcp-app",
    "pretypecheck": "npm run build:mcp-app",
    "preverify": "npm run build:mcp-app",
    "dev": "astro dev",
    "build": "astro build && node scripts/build-server.mjs",
    "start": "node ./dist/server/main.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --report-unused-disable-directives src test",
    "test": "vitest run",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --project tsconfig.check.json && astro check",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/preact": "^6.0.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/mcp-extensions": "^0.1.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "astro": "^7.3.6",
    "compression": "^1.8.2",
    "marked": "^18.1.0",
    "preact": "^10.29.8",
    "queryhost": "1.7.0",
    "shiki": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2001",
    "preact-render-to-string": "^6.8.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
