{
  "name": "@queryhost/web",
  "description": "QueryHost public site, documentation, and playground boundary.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --report-unused-disable-directives src test",
    "test": "vitest run",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --project tsconfig.check.json && astro check",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.2.4",
    "marked": "^18.0.10",
    "queryhost": "file:vendor/queryhost-0.0.0.tgz",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  }
}
